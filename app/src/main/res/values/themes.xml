<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Only the window the app opens onto is set here; everything the app
         draws comes from the Compose theme. The background matches what that
         theme paints, so launching does not flash a colour the app never uses. -->
    <style name="Theme.LotoLivre" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
