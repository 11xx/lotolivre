<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer for API 31 and above. The theme
     choice restores; nothing else the app holds is worth carrying, and the
     cached results are re-fetchable. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
