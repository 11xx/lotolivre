<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Four interlocking rings around a gold star. Ring centres sit 78 from
         the origin at 70 outer and 36 inner radius, so the holes stay clear of
         their neighbours and the origin falls outside every ring. The scale
         spans the 66dp safe zone, so every launcher mask shows the whole mark
         at the size it was drawn to read at; the numerals, the weave notches
         and the inlay strokes the master artwork carries fall under a pixel
         here and are left to the in-app logo. -->
    <group
        android:translateX="54"
        android:translateY="54"
        android:scaleX="0.21"
        android:scaleY="0.21">

        <path
            android:fillColor="#347C5A"
            android:fillType="evenOdd"
            android:pathData="M 0,-148 A 70,70 0 1,0 0,-8 A 70,70 0 1,0 0,-148 Z M 0,-114 A 36,36 0 1,1 0,-42 A 36,36 0 1,1 0,-114 Z" />
        <path
            android:fillColor="#2D6A4F"
            android:fillType="evenOdd"
            android:pathData="M 78,-70 A 70,70 0 1,0 78,70 A 70,70 0 1,0 78,-70 Z M 78,-36 A 36,36 0 1,1 78,36 A 36,36 0 1,1 78,-36 Z" />
        <path
            android:fillColor="#1B4332"
            android:fillType="evenOdd"
            android:pathData="M 0,8 A 70,70 0 1,0 0,148 A 70,70 0 1,0 0,8 Z M 0,42 A 36,36 0 1,1 0,114 A 36,36 0 1,1 0,42 Z" />
        <path
            android:fillColor="#235840"
            android:fillType="evenOdd"
            android:pathData="M -78,-70 A 70,70 0 1,0 -78,70 A 70,70 0 1,0 -78,-70 Z M -78,-36 A 36,36 0 1,1 -78,36 A 36,36 0 1,1 -78,-36 Z" />

        <path
            android:fillColor="#D4AF37"
            android:pathData="M 0,-16 Q 0,0 16,0 Q 0,0 0,16 Q 0,0 -16,0 Q 0,0 0,-16 Z" />
    </group>
</vector>
